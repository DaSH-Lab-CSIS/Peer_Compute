+def get_loadbalancer_id():
+    """Get load balancer identifier"""
+    lb_id = os.environ.get('LOADBALANCER_ID')
+    if not lb_id:
+        hostname = socket.gethostname()
+        lb_id = f"LOADBALANCER_{hostname.split('.')[0]}"
+    return lb_id
